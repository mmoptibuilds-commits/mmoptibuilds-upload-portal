{
  "name": "mmoptibuilds-upload-portal",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --require ./scripts/compat-memory.cjs ./node_modules/next/dist/bin/next dev --turbopack -H 127.0.0.1",
    "build": "node --require ./scripts/compat-memory.cjs ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:watch": "node --experimental-strip-types --test --watch tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.44.7",
    "google-auth-library": "^9.15.1",
    "motion": "^12.23.24",
    "next": "15.5.9",
    "nodemailer": "^6.10.1",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.36.0",
    "eslint-config-next": "15.5.9",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.46.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
