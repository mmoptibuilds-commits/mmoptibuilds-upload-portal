# Supabase server-side Postgres connection string.
# For Vercel, copy the Transaction pooler URI exactly from Supabase > Connect
# (usually port 6543). Do not use the direct db.* host on an IPv4-only runtime.
DATABASE_URL=postgresql://postgres.ldjxwsjwtthynxzkzrdw:<DATABASE_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Supabase Storage server-side credentials. Never expose the service-role key
# through a NEXT_PUBLIC_ variable or client-side module.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=client-uploads

# Optional completion notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL=mmoptibuilds@gmail.com

# Required for the first seed only. Use strong unique passwords.
INITIAL_MMOPTIBUILDS_PASSWORD=
INITIAL_TWAHA_PASSWORD=
INITIAL_ADMIN_PASSWORD=
