# Supabase server-side Postgres connection string.
# For Vercel, copy the Transaction pooler URI exactly from Supabase > Connect
# (usually port 6543). Do not use the direct db.* host on an IPv4-only runtime.
DATABASE_URL=postgresql://postgres.ldjxwsjwtthynxzkzrdw:<DATABASE_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Google Cloud service-account credentials used by the server only.
GOOGLE_PROJECT_ID=your-google-cloud-project-id
GOOGLE_CLIENT_EMAIL=upload-portal@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=1Ok4FuEf1cfwkt-hkibgadWUeD-0YSXgB
# Recommended for production: the Shared Drive ID containing the root folder.
# Leave blank only when using delegated user impersonation or a My Drive setup
# with confirmed service-account quota.
GOOGLE_DRIVE_SHARED_DRIVE_ID=
# Optional alternative for a Google Workspace domain-wide-delegation setup.
# If set, the service account impersonates this Workspace user for My Drive.
GOOGLE_IMPERSONATE_EMAIL=

# Optional completion notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL=mmoptibuilds@gmail.com

# Required for the first seed only. Use strong unique passwords.
INITIAL_MMOPTIBUILDS_PASSWORD=
INITIAL_TWAHA_PASSWORD=
INITIAL_ADMIN_PASSWORD=
