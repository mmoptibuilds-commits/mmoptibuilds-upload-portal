# Required: Supabase Postgres connection string (use the pooled connection string for Vercel).
DATABASE_URL=
# Required: 32+ random characters. Generate with: openssl rand -base64 48
AUTH_SECRET=
# Google service-account credentials. Share the destination Drive folder with GOOGLE_CLIENT_EMAIL.
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Optional email notification. Omit all SMTP values during local UI development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL=mmoptibuilds@gmail.com
NEXT_PUBLIC_APP_NAME=mmoptibuilds Upload
# Required only while running npm run db:seed. Do not commit this file with values.
INITIAL_MMOPTIBUILDS_PASSWORD=
INITIAL_TWAHA_PASSWORD=
INITIAL_ADMIN_PASSWORD=
